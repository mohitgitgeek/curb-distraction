# YouTube Data API v3 Key (Optional, enables fetching real metadata from YouTube)
# Get a free key at: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# Gemini API Key (Optional, enables text-embedding-004 for vector embeddings)
# If omitted, FocusCurb uses the built-in fast local subword vectorizer with zero external dependencies!
GEMINI_API_KEY=
